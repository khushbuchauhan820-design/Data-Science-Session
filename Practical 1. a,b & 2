    {
      "cell_type": "code",
      "source": [
        "#Formatted Output Statements in Python\n",
        "Name=\"Khushbu Chauhan\"\n",
        "Age=18\n",
        "Marks=80.5\n",
        "Pi=3.14159265\n",
        "\n",
        "print(\"Uing f-string:\")\n",
        "print(f\"Name:{Name}\")\n",
        "print(f\"Age:{Age}\")\n",
        "print(f\"Marks:{Marks}\")\n",
        "print(f\"Pi :{Pi:.3f}\")\n",
        "\n",
        "print(\"\\nUsing format() method:\")\n",
        "print(\"Name:{}\".format(Name))\n",
        "print(\"Age:{}\".format(Age))\n",
        "print(\"Marks:{}\".format(Marks))\n",
        "print(\"Pi:{:.3f}\".format(Pi))\n",
        "\n",
        "print(\"\\nUsing % operator:\")\n",
        "print(\"Name:%s\" % Name)\n",
        "print(\"Age:%d\" % Age)\n",
        "print(\"Marks:%.2f\" % Marks)\n",
        "print(\"Pi:%.3f\" % Pi)\n"
      ],
